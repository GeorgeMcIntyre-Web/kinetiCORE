<mujoco model="simple_test">
  <compiler angle="radian"/>
  
  <default>
    <geom type="box" size="0.1 0.1 0.1" rgba="0.7 0.7 0.7 1"/>
  </default>

  <worldbody>
    <body name="base" pos="0 0 0">
      <geom name="base_box" type="box" size="0.2 0.2 0.1"/>
      
      <body name="arm" pos="0 0 0.2">
        <geom name="arm_box" type="box" size="0.1 0.1 0.1"/>
        <joint name="shoulder" type="hinge" axis="0 0 1" range="-1.57 1.57"/>
        
        <body name="forearm" pos="0 0 0.2">
          <geom name="forearm_box" type="box" size="0.1 0.1 0.1"/>
          <joint name="elbow" type="hinge" axis="0 1 0" range="-1.57 1.57"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor joint="shoulder" gear="1"/>
    <motor joint="elbow" gear="1"/>
  </actuator>
</mujoco>
