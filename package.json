{
  "name": "kineticore",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web-based 3D industrial simulation and kinematics platform",
  "author": "George McIntyre, Cole, Edwin",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 20",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "prepare": "husky install",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name=kineticore",
    "deploy:production": "npm run build && wrangler pages deploy dist --project-name=kineticore --branch=main",
    "pages:dev": "wrangler pages dev dist"
  },
  "dependencies": {
    "@babylonjs/addons": "^8.30.4",
    "@babylonjs/core": "^8.30.4",
    "@babylonjs/gui": "^8.30.4",
    "@babylonjs/loaders": "^8.30.4",
    "@babylonjs/materials": "^8.30.4",
    "@dimforge/rapier3d-compat": "^0.11.2",
    "@mlightcad/data-model": "^1.2.20",
    "@mlightcad/libredwg-converter": "^3.0.20",
    "@mlightcad/libredwg-web": "^0.3.0",
    "@types/three": "^0.180.0",
    "axios": "^1.12.2",
    "dockview-react": "^4.9.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.544.0",
    "manifold-3d": "^3.2.1",
    "multer": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^3.0.6",
    "three": "^0.180.0",
    "urdf-loader": "^0.12.6",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.19",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.3.1",
    "@vitest/ui": "^1.6.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "happy-dom": "^12.10.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "postcss": "^8.5.6",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.2",
    "vite": "^5.4.0",
    "vitest": "^1.3.1",
    "wrangler": "^3.80.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
