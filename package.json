{
  "name": "kineticore",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "The Linux of Manufacturing Simulation - Web-based 3D industrial simulation and kinematics platform",
  "author": "George McIntyre, Cole, Edwin",
  "license": "MIT",
  "scripts": {
    "usd:server": "python server/usd_converter.py",
    "usd:server:win": "py server/usd_converter.py",
    "dev": "concurrently -k -n VITE,USD \"vite\" \"python server/usd_converter.py\"",
    "dev:ui": "vite",
    "dev:full": "concurrently -k -n VITE,USD,SUPABASE \"vite\" \"python server/usd_converter.py\" \"supabase start\"",
    "build": "tsc && vite build",
    "build:ci": "npm ci && tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 20",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:fea": "playwright test tests/e2e/fea-backend-demo.spec.ts",
    "snap:harness": "tsx scripts/snap-harness.ts",
    "debug:vertices": "http-server ./ -p 8080 -c-1",
    "tooling:units": "tsx scripts/tooling-unit-builder.ts",
    "tooling:pipeline": "tsx scripts/tooling-pipeline.ts",
    "tooling:profile": "tsx scripts/tooling-structure-profiler.ts",
    "tooling:regression": "tsx scripts/tooling-regression.ts",
    "tooling:pipeline:batch": "tsx scripts/tooling-pipeline-batch.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "prepare": "husky install",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name=kineticore",
    "deploy:production": "npm run build && wrangler pages deploy dist --project-name=kineticore --branch=main",
    "pages:dev": "wrangler pages dev dist",
    "usd-server": "python server/usd_converter.py",
    "usd-server:dev": "FLASK_ENV=development python server/usd_converter.py",
    "download-usd-models": "python scripts/download_usd_models.py",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > src/types/supabase.ts",
    "supabase:deploy": "supabase db push && supabase functions deploy",
    "supabase:functions:deploy": "supabase functions deploy",
    "supabase:storage:create": "supabase storage create",
    "supabase:logs": "supabase logs"
  },
  "dependencies": {
    "@babylonjs/addons": "^8.30.4",
    "@babylonjs/core": "^8.38.0",
    "@babylonjs/gui": "^8.38.0",
    "@babylonjs/inspector": "8.30.4",
    "@babylonjs/loaders": "^8.38.0",
    "@babylonjs/materials": "^8.38.0",
    "@babylonjs/serializers": "^8.30.4",
    "@dimforge/rapier3d-compat": "^0.11.2",
    "@mlightcad/data-model": "^1.2.20",
    "@mlightcad/libredwg-converter": "^3.0.20",
    "@mlightcad/libredwg-web": "^0.3.0",
    "@supabase/supabase-js": "^2.76.1",
    "@types/three": "^0.180.0",
    "axios": "^1.12.2",
    "dockview-react": "^4.9.0",
    "dotenv": "^17.2.3",
    "earcut": "^3.0.2",
    "express": "^5.1.0",
    "icpts": "^0.6.0",
    "jspdf": "^3.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.544.0",
    "manifold-3d": "^3.2.1",
    "multer": "^2.0.2",
    "numeric": "^1.2.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^3.0.6",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.2",
    "urdf-loader": "^0.12.6",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.19",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.3.1",
    "@vitest/ui": "^1.6.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "happy-dom": "^12.10.3",
    "http-server": "^14.1.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "postcss": "^8.5.6",
    "prettier": "^3.2.5",
    "supabase": "^2.53.6",
    "tailwindcss": "^3.4.17",
    "terser": "^5.44.0",
    "tsx": "^4.20.6",
    "typescript": "^5.4.2",
    "vite": "^5.4.0",
    "vitest": "^1.3.1",
    "wrangler": "^3.80.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
